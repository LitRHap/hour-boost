# Akun Steam
STEAM_USERNAME=
STEAM_PASSWORD=
# Opsional: shared_secret agar kode Steam Guard otomatis (kalau kosong, kode ditanya di terminal)
STEAM_SHARED_SECRET=

# Daftar AppID dipisah koma (maks 32). Contoh: 730,440,570
GAMES=730,440
# Opsional: teks custom yang tampil sebagai game non-Steam (tidak ikut menambah jam game asli)
CUSTOM_GAME=

# online | invisible | away | busy | snooze
PERSONA_STATE=invisible

# Port health-check (untuk Heroku/Railway/Koyeb dsb). Kosongkan untuk menonaktifkan
PORT=3000
LOG_LEVEL=info
